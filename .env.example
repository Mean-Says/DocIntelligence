# Database
POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel
POSTGRES_DB=docintelligence
DATABASE_URL=postgresql+asyncpg://docintel:docintel@db:5432/docintelligence

# Redis
REDIS_URL=redis://redis:6379

# AI
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Storage (Cloudflare R2)
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=docintelligence

# Pipeline thresholds
THRESHOLD_L1=0.85
THRESHOLD_L2=0.82
THRESHOLD_L3=0.78
LEARNING_LOOP_AUTO_PROMOTE=0.90
LEARNING_LOOP_QUEUE_HUMAN=0.70
LEARNING_LOOP_ACCUMULATE_N=3

# Limits
MAX_FILE_SIZE_MB=50
RULE_CACHE_TTL_SECONDS=300

# App
ENV=development
SECRET_KEY=change-me-in-production
